# App
APP_DEBUG=true
APP_API_PREFIX=/api

# Database
APP_DATABASE_URL=postgresql+asyncpg://desperdicio:password@localhost:5432/desperdicio_zero

# JWT (for development, generate keys with: python -c "from app.core.security import generate_rsa_key_pair; print(generate_rsa_key_pair())")
APP_JWT_PRIVATE_KEY_PATH=./keys/private_key.pem
APP_JWT_PUBLIC_KEY_PATH=./keys/public_key.pem

# Mercado Pago
APP_MERCADO_PAGO_ACCESS_TOKEN=TEST-xxx
APP_MERCADO_PAGO_SANDBOX=true

# Email (Resend)
APP_RESEND_API_KEY=re_xxx
APP_EMAIL_FROM=noreply@desperdiciozero.com.br

# CORS
APP_CORS_ORIGINS=["http://localhost:3000"]
