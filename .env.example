# Database
DB_PASSWORD=devpassword

# Google OAuth (opcional — login/cadastro com Google)
# Crie credenciais em https://console.cloud.google.com/ (tipo: Aplicação da Web)
# e adicione http://localhost:8000/api/auth/google/callback como URI de redirecionamento.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Métricas de produto (opcional — grátis):
# PostHog: pageviews, funil e usuários (1M eventos/mês no free tier)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Microsoft Clarity: gravações de sessão e heatmaps (grátis e ilimitado)
NEXT_PUBLIC_CLARITY_ID=
